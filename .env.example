# =========================================================================
# LinkedIn Local Owerri Volunteer Engagement Tracking System
# Environment Configuration Template (.env.example)
# =========================================================================

# -------------------------------------------------------------------------
# Supabase Client Configuration (Frontend)
# Find these in Supabase Dashboard -> Project Settings -> API
# -------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Public "anon" API Key (safe for browser)
VITE_SUPABASE_ANON_KEY=

# -------------------------------------------------------------------------
# Supabase Privileged Configuration (Serverless API Functions / Vercel)
# Never prefix with VITE_ to keep confidential!
# -------------------------------------------------------------------------
# Same project URL as above
SUPABASE_URL=

# Your Supabase "service_role" Secret Key (bypasses RLS on server)
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------------
# Programme Localization
# -------------------------------------------------------------------------
VITE_PROGRAMME_TIMEZONE=Africa/Lagos
