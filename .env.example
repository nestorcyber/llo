# =========================================================================
# LinkedIn Local Owerri Volunteer Engagement Tracking System
# Environment Configuration Template (.env.example)
# =========================================================================

# -------------------------------------------------------------------------
# PUBLIC KEYS (Frontend / Safe for Browser & Bundled by Vite)
# -------------------------------------------------------------------------
# [PUBLIC] Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# Visible in browser network traffic. Used by client React app.
VITE_SUPABASE_URL=

# [PUBLIC] Your Supabase Public "anon" API Key
# Safe for browser. Restricted by Supabase Row-Level Security (RLS) policies.
VITE_SUPABASE_ANON_KEY=

# [PUBLIC] Programme Localization Timezone
# Used for display and client time calculations (West Africa Time, UTC+1).
VITE_PROGRAMME_TIMEZONE=Africa/Lagos

# -------------------------------------------------------------------------
# SECRET KEYS (Backend / Serverless Functions ONLY - Confidential)
# Add these in your Vercel/Hosting Dashboard -> Project Settings -> Environment Variables.
# NEVER prefix with VITE_ and NEVER commit actual keys to GitHub!
# -------------------------------------------------------------------------
# [SERVER] Same project URL as above (Used by Vercel serverless /api/* endpoints)
SUPABASE_URL=

# [SECRET / HIGHLY SENSITIVE] Supabase "service_role" Secret Key
# Bypasses Row-Level Security (RLS) on server for backend verification, volunteer persistence & admin mutations.
SUPABASE_SERVICE_ROLE_KEY=
